CACHE MANIFEST
# Ping Score – cache hors ligne pour les anciens Safari (iPad 2 / iOS 9), sans service worker.
# Les navigateurs récents ignorent ce fichier et utilisent sw.js.
# IMPORTANT : changer la ligne « version » à chaque mise à jour du site, sinon l'iPad garde l'ancienne version.
# version 2026-10-28a

CACHE:
index.html
config.js
logo.svg
favicon.png
apple-touch-icon.png

# Tout le reste (envoi des scores, direct, télécommande, police) passe par le réseau quand il est là
NETWORK:
*
